{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "layton",
  "compatibility_date": "2026-07-30",
  // Canonical origin. Passkeys are pinned to a single WebAuthn rp_id, so this
  // host is the one that can sign you in with Face ID / Touch ID.
  "routes": [{ "pattern": "layton.space", "custom_domain": true }],
  "assets": {
    // The whole app is a static SPA talking directly to Supabase, so there is
    // no Worker script here — Cloudflare just serves the build and routes every
    // unknown path back to index.html for client-side routing.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
